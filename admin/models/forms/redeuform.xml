<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="basic" label="COM_REDEUFORM_SETTINGS_FIELDSET_EMAIL">
        <field
            name="receiving_email"
            type="email"
            label="COM_REDEUFORM_PARAM_RECEIVING_EMAIL_LABEL"
            description="COM_REDEUFORM_PARAM_RECEIVING_EMAIL_DESC"
            size="50"
            required="true"
        />
        <field
            name="sendfrom_email"
            type="email"
            label="COM_REDEUFORM_PARAM_SENDFROM_EMAIL_LABEL"
            description="COM_REDEUFORM_PARAM_SENDFROM_EMAIL_DESC"
            size="50"
        />
        <field
            name="email_template"
            type="textarea"
            label="COM_REDEUFORM_PARAM_EMAIL_TEMPLATE_LABEL"
            description="COM_REDEUFORM_PARAM_EMAIL_TEMPLATE_DESC"
            rows="12"
            cols="60"
            default="From:    {name}&#10;Email:   {email}&#10;Phone:   {phone}&#10;&#10;Message:&#10;{message}&#10;&#10;---&#10;Sent to:   {receiving_email}&#10;Send-as:   {sendfrom_email}"
        />
    </fieldset>
    <fieldset name="turnstile" label="COM_REDEUFORM_SETTINGS_FIELDSET_TURNSTILE">
        <field
            name="turnstile_site_key"
            type="text"
            label="COM_REDEUFORM_PARAM_TURNSTILE_SITE_KEY_LABEL"
            description="COM_REDEUFORM_PARAM_TURNSTILE_SITE_KEY_DESC"
            size="60"
        />
        <field
            name="turnstile_secret_key"
            type="text"
            label="COM_REDEUFORM_PARAM_TURNSTILE_SECRET_KEY_LABEL"
            description="COM_REDEUFORM_PARAM_TURNSTILE_SECRET_KEY_DESC"
            size="60"
        />
    </fieldset>
</form>
